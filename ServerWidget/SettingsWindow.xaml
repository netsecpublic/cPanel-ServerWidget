<Window x:Class="ServerWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Settings" Height="580" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Opacity Slider -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Widget Opacity:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DockPanel>
                <TextBlock x:Name="OpacityText" Text="90%" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0" Value="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged"/>
            </DockPanel>
        </StackPanel>

        <!-- Toggles & Audio Configuration -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Offline / High Queue Alert Sound (.wav):" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AudioPathTextBox" Grid.Column="0" VerticalAlignment="Center" Padding="4,3" Background="#252526" Foreground="White" BorderBrush="#3F3F46"/>
                <Button Content="Browse..." Grid.Column="1" Width="70" Height="26" Margin="5,0,0,0" Click="BrowseAudio_Click"/>
                <Button Content="Test" Grid.Column="2" Width="50" Height="26" Margin="5,0,0,0" Click="TestAudio_Click"/>
            </Grid>
            <CheckBox x:Name="SoundAlertsCheckBox" Content="Enable Audio Alerts on Error / High Queue" Foreground="White" Margin="0,5,0,0"/>
            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Keep Widget Always on Top" Foreground="White" Margin="0,5,0,0"/>
            <CheckBox x:Name="MaximizeOnErrorCheckBox" Content="Maximize from Tray automatically on Error / High Queue" Foreground="White" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Servers Header & Buttons -->
        <DockPanel Grid.Row="2" Margin="0,0,0,5">
            <TextBlock Text="Monitored Servers:" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add" Width="60" Margin="0,0,5,0" Click="AddButton_Click"/>
                <Button Content="Remove" Width="60" Click="RemoveButton_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Server List Grid -->
        <DataGrid x:Name="ServersGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="#252526" RowBackground="#2D2D30" AlternatingRowBackground="#333337"
                  Foreground="White" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  BorderBrush="#3F3F46" BorderThickness="1">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E1E1E"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Display Label" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Host / Endpoint" Binding="{Binding Host}" Width="1.2*"/>
                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="50"/>
                <DataGridTextColumn Header="API Token / Secret" Binding="{Binding ApiToken}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Save Button -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save &amp; Close" Width="100" Height="30" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>